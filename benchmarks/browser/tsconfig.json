{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@moritzbrantner/tables": ["./src/index.ts"],
      "@moritzbrantner/tables/data": ["./src/data.ts"],
      "@moritzbrantner/tables/react": ["./src/react-rust.tsx"],
      "@moritzbrantner/tables/view-state": ["./src/view-state.ts"],
      "@moritzbrantner/tables/virtualization": ["./src/virtualization.ts"],
      "@moritzbrantner/tables/wasm": ["./src/wasm.ts"],
      "react": ["./benchmarks/browser/node_modules/@types/react"],
      "react/*": ["./benchmarks/browser/node_modules/@types/react/*"]
    }
  },
  "include": ["./*.ts", "./*.tsx", "../../src/**/*.ts", "../../src/**/*.tsx"],
  "exclude": ["../../src/**/*.test.ts", "../../src/**/*.test.tsx"]
}
